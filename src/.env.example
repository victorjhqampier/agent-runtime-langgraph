# ==============================================================================
# Plantilla de entorno - Arify Agent Runtime
# ==============================================================================
# Copia este archivo a src/.env y completa los valores reales para tu entorno.
# NO versionar secretos reales ni connection strings en src/.env.
# Todas las Settings de Infrastructure leen de src/.env (env_file="src/.env").
# ==============================================================================

COGNITO_JWKS_REGION="us-east-1"
COGNITO_JWKS_POOL_ID="us-east-1_k2HD1orIX"

# ------------------------------------------------------------------------------
# 1. LLM - AWS Bedrock
# ------------------------------------------------------------------------------
RUNTIME_LLM_PROVIDER=AWS_BEDROCK
AWS_BEDROCK_LLM_REGION=us-east-1
AWS_BEDROCK_LLM_MODEL_ID=tu-modelo-de-bedrock
AWS_BEDROCK_LLM_TEMPERATURE=0.0
AWS_BEDROCK_LLM_MAX_TOKENS=1200
AWS_BEDROCK_LLM_CONNECT_TIMEOUT_SECONDS=5.0
AWS_BEDROCK_LLM_READ_TIMEOUT_SECONDS=30.0
AWS_BEDROCK_LLM_MAX_ATTEMPTS=3
AWS_BEDROCK_LLM_MAX_POOL_CONNECTIONS=50

# ------------------------------------------------------------------------------
# 2. RAG - AWS Bedrock Knowledge Base
# ------------------------------------------------------------------------------
RUNTIME_RAG_PROVIDER=AWS_BEDROCK
AWS_BEDROCK_RAG_REGION=us-east-1
AWS_BEDROCK_RAG_KNOWLEDGE_BASE_ID=tu-id-de-base-de-conocimiento
AWS_BEDROCK_RAG_NUMBER_OF_RESULTS=5
AWS_BEDROCK_RAG_SEARCH_TYPE=HYBRID
AWS_BEDROCK_RAG_MAX_ATTEMPTS=2
AWS_BEDROCK_RAG_CONNECT_TIMEOUT_SECONDS=5.0
AWS_BEDROCK_RAG_READ_TIMEOUT_SECONDS=15.0
AWS_BEDROCK_RAG_MAX_POOL_CONNECTIONS=50

# ------------------------------------------------------------------------------
# 3. Memoria y Checkpointer - AWS Redis
# ------------------------------------------------------------------------------
RUNTIME_MEMORY_PROVIDER=AWS_REDIS
AWS_REDIS_MEMORY_HOST=tu-host-de-redis
AWS_REDIS_MEMORY_PORT=6379
AWS_REDIS_MEMORY_PASSWORD=
AWS_REDIS_MEMORY_DB=1
AWS_REDIS_MEMORY_SSL=false
AWS_REDIS_MEMORY_NAMESPACE=agent-runtime
# AWS_REDIS_MEMORY_TTL_SECONDS=3600
AWS_REDIS_MEMORY_MAX_CONNECTIONS=100
AWS_REDIS_MEMORY_CONNECT_TIMEOUT_SECONDS=1.0
AWS_REDIS_MEMORY_TIMEOUT_SECONDS=2.0

# ------------------------------------------------------------------------------
# 4. Guardrail - AWS Bedrock Guardrails
# ------------------------------------------------------------------------------
RUNTIME_GUARDRAIL_PROVIDER=AWS_BEDROCK
AWS_BEDROCK_GUARDRAIL_ENABLED=true
AWS_BEDROCK_GUARDRAIL_REGION=us-east-1
AWS_BEDROCK_GUARDRAIL_ID=tu-id-de-guardrail
AWS_BEDROCK_GUARDRAIL_VERSION=tu-version-de-guardrail
AWS_BEDROCK_GUARDRAIL_CONNECT_TIMEOUT_SECONDS=5.0
AWS_BEDROCK_GUARDRAIL_READ_TIMEOUT_SECONDS=15.0
AWS_BEDROCK_GUARDRAIL_MAX_ATTEMPTS=2

# ------------------------------------------------------------------------------
# 5. Ticketing externo - iTop
# ------------------------------------------------------------------------------
RUNTIME_TOOL_PROVIDER=ITOP
ITOP_TOOL_BASE_URL=tu-url-de-itop
ITOP_TOOL_CREATE_TICKET_PATH=/api/tickets
ITOP_TOOL_LOOKUP_IDEMPOTENCY_PATH=/api/tickets/idempotency/{idempotency_key}
ITOP_TOOL_AUTH_MODE=BEARER
ITOP_TOOL_AUTH_TOKEN=tu-token-de-autorizacion
ITOP_TOOL_USERNAME=tu-usuario
ITOP_TOOL_PASSWORD=tu-password
ITOP_TOOL_TIMEOUT_SECONDS=9.0
ITOP_TOOL_CONNECT_TIMEOUT_SECONDS=3.0
ITOP_TOOL_DEFAULT_ORGANIZATION=tu-organizacion
ITOP_TOOL_DEFAULT_SERVICE=tu-servicio

# ------------------------------------------------------------------------------
# 6. Seguridad - Runtime Security
# ------------------------------------------------------------------------------
RUNTIME_SECURITY_PII_REDACTION_ENABLED=true
RUNTIME_SECURITY_SENSITIVE_VALUE_MASK=[REDACTED]
RUNTIME_SECURITY_CHECKPOINT_MINIMIZATION_ENABLED=true
